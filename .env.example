# ==============================================================================
# Lenny Growth Assistant - Production & Docker Environment Template (.env.example)
# Copy this file to .env and configure your credentials before running:
#   docker-compose up --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL with pgvector Database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Connection URLs:
# For Docker Compose (using container name 'postgres'):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/lenny_growth_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lenny_growth_db

# For Local Development outside Docker (uncomment if running locally):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth_db
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth_db

# ------------------------------------------------------------------------------
# 3. Dual Model Layer Configuration (Local vs Cloud Switching)
# ------------------------------------------------------------------------------
# Active Provider: "cloud" (recommended for long-form) or "ollama" (mandatory local demo)
LLM_PROVIDER=cloud

# Automatic Fallback: If cloud generation fails, automatically falls back to local Ollama
FALLBACK_TO_LOCAL=true

# ------------------------------------------------------------------------------
# 4. Cloud LLM Provider (Anthropic Claude via OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=anthropic/claude-sonnet-4
CLOUD_PROVIDER=openrouter

# Direct Provider Keys (Optional alternatives)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Local LLM Provider (Ollama - Mandatory Local Demo)
# ------------------------------------------------------------------------------
# In Docker, use host.docker.internal to reach Ollama running on your host machine:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# For local development outside Docker, use: http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# 6. RAG & Embeddings Configuration
# ------------------------------------------------------------------------------
# Embedding provider: "ollama"
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=50
SIMILARITY_TOP_K=6
SIMILARITY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 7. Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
# Client-side API URL used by browser to communicate with backend
NEXT_PUBLIC_API_URL=http://localhost:8000

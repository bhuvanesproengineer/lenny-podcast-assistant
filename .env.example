# ==============================================================================
# Lenny Growth Assistant - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# PostgreSQL with pgvector Database (Neon DB / Local PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require

# ------------------------------------------------------------------------------
# Dual Model Layer Selection
# ------------------------------------------------------------------------------
# Active LLM provider: "ollama" (Local mode) or "cloud" (Groq Cloud mode)
LLM_PROVIDER=ollama
FALLBACK_TO_LOCAL=true

# ------------------------------------------------------------------------------
# Local Mode (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# Cloud Mode (Groq Inference)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# Embeddings & RAG Configuration
# ------------------------------------------------------------------------------
# Embedding provider: "ollama" (Local) or "gemini" (Cloud)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=50
SIMILARITY_TOP_K=4
SIMILARITY_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# Gemini Cloud Embeddings (Used when LLM_PROVIDER=cloud or EMBEDDING_PROVIDER=gemini)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# Cloud Token Budget & TPM Protection Controls (Cloud Mode Only)
# ------------------------------------------------------------------------------
CLOUD_TOP_K=4
CLOUD_MAX_CONTEXT_TOKENS=1800
CLOUD_TPM_LIMIT=20000

# ------------------------------------------------------------------------------
# Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
